{
  "name": "juandre-art-portfolio",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "preview": "vite preview",
    "lint": "oxlint --config .oxlintrc.json src",
    "lint:fix": "oxlint --config .oxlintrc.json --fix src",
    "ts-check": "tsc --noEmit",
    "ch": "node scripts/ch.js",
    "pre-commit": "pnpm exec lint-staged && pnpm run ch",
    "prepare": "husky"
  },
  "dependencies": {
    "@emotion/react": "^11.8.2",
    "@emotion/styled": "^11.8.1",
    "@mui/icons-material": "9.5.0",
    "@mui/material": "9.5.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.0",
    "@react-three/rapier": "^2.2.0",
    "@types/three": "^0.186.0",
    "lamina": "^1.2.2",
    "postprocessing": "^6.39.5",
    "react": "^19.3.1",
    "react-device-detect": "^2.2.3",
    "react-dom": "^19.3.1",
    "react-router": "8.4.0",
    "shaders": "^4.0.4",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/ui": "^5.0.4",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "r3f-perf": "^7.2.3",
    "shadow-dom-testing-library": "^1.14.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-glsl": "^1.6.2",
    "vitest": "^5.0.4"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "pnpm exec oxlint --config .oxlintrc.json"
    ],
    "src/**/*.test.tsx": [
      "pnpm exec vitest run"
    ]
  }
}
